# API Base URL for Backend
# Development: Leave empty or set to http://localhost:5005
# Production (Vercel): Set to your Render backend URL
# Example: VITE_API_BASE_URL=https://my-portfolio-api.onrender.com
VITE_API_BASE_URL=https://portfolio-api-4imj.onrender.com

# Note: If VITE_API_BASE_URL is empty, the app will use relative paths (/api)
# which works when frontend and backend are served from the same origin