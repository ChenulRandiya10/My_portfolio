# MongoDB Atlas Connection String
# Get this from MongoDB Atlas > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Server Port (Render will set this automatically)
PORT=5005

# Frontend URL(s) for CORS (comma-separated for multiple environments)
# Example: CLIENT_URL=https://myportfolio.vercel.app,https://myportfolio.com
CLIENT_URL=http://localhost:5173

# Admin Password for Messages Dashboard
# Choose a strong password and keep it secret
MESSAGES_ADMIN_PASSWORD=your_secure_admin_password_here

# Node Environment
NODE_ENV=development