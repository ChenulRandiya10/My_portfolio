# Copy this file to server/.env and fill in your values.

# Port the API server listens on. Must match the Vite proxy target in
# client/vite.config.js (default 5005).
PORT=5005

# MongoDB connection string. Required only for the contact form and image
# endpoints. The site renders fine without it.
# Example (local):  mongodb://127.0.0.1:27017/portfolio
# Example (Atlas):  mongodb+srv://<user>:<password>@<cluster>/portfolio
MONGO_URI=
