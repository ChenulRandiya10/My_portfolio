{
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && chmod -R +x node_modules/.bin",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}